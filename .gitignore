
# Virtual environments
.venv/
venv/

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/

# Environment variables
.env
.env.*

# Database files
*.db
*.sqlite
*.sqlite3

# Generated OMR processing files
data/raw/*
data/processed/*

# Uploaded files and generated reports
uploads/*
reports/*

# Keep required directories in Git
!data/raw/.gitkeep
!data/processed/.gitkeep
!uploads/.gitkeep
!reports/.gitkeep
